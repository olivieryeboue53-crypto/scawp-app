# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is gitignored — never commit real secrets.

[db]
path = "data/scawp.db"

[bootstrap]
# Identity metadata only — no passwords here. Temporary passwords are
# generated randomly by scripts/bootstrap_db.py and printed once to the
# console for secure out-of-band handoff.
directeur_username = "directeur"
directeur_full_name = "Nom du Directeur"
adg_username = "adg"
adg_full_name = "Nom de l'ADG"
